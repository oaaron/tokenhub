    "requestExample": "{\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"你好，请介绍一下自己\"\n    }\n  ],\n  \"model\": \"claude-fable-5-1\"\n}",
    "responseExample": "{\n  \"role\": \"assistant\",\n  \"usage\": {\n    \"output_tokens\": 12,\n    \"input_tokens\": 9\n  },\n  \"stop_reason\": \"end_turn\",\n  \"model\": \"claude-fable-5-1\",\n  \"id\": \"msg_123\",\n  \"type\": \"message\",\n  \"content\": [\n    {\n      \"text\": \"你好！我是 claude-fable-5-1...\",\n      \"type\": \"text\"\n    }\n  ]\n}",

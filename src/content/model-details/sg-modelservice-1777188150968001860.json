  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加 x-goog-api-key：",
    "authBearerPlaceholder": "<api_key>",
    "requestIntro": "使用 Gemini Generate Content 协议：",
    "requestExample": "{\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"你好，请介绍一下自己\"\n        }\n      ]\n    }\n  ]\n}",
    "responseExample": "{\n  \"candidates\": [\n    {\n      \"finishReason\": \"STOP\",\n      \"content\": {\n        \"role\": \"model\",\n        \"parts\": [\n          {\n            \"text\": \"你好！我是 Gemini...\"\n          }\n        ]\n      }\n    }\n  ],\n  \"usageMetadata\": {\n    \"candidatesTokenCount\": 12,\n    \"totalTokenCount\": 21,\n    \"promptTokenCount\": 9\n  }\n}",
    "docUrl": "https://ai.google.dev/api/generate-content",
    "docLabel": "查看完整 API 文档"
  },
  "exampleCodes": {
    "python": {
      "sectionTitle": "Python 示例",
      "installLine": "安装依赖：pip install google-genai",
      "code": "# pip install google-genai\nfrom google import genai\nfrom google.genai import types\n\nclient = genai.Client(\n    api_key=\"<api_key>\",\n    http_options=types.HttpOptions(base_url=\"http://10.191.0.202\"),\n)\n\nresponse = client.models.generate_content(\n    model=\"gemini-2.5-pro\",\n    contents=\"What is the meaning of life?\",\n)\nprint(response.text)"
    },
    "javascript": {
      "sectionTitle": "JavaScript 示例",
      "installLine": "无需安装额外依赖（需 Node 18+ 或支持 fetch 的运行环境）",
      "code": "const response = await fetch(\"http://10.191.0.202/v1beta/models/gemini-2.5-pro:generateContent\", {\n  method: \"POST\",\n  headers: {\n    \"x-goog-api-key\": \"<api_key>\",\n    \"Content-Type\": \"application/json\"\n  },\n  body: JSON.stringify({\n    contents: [{ role: \"user\", parts: [{ text: \"What is the meaning of life?\" }] }]\n  })\n});\nconst result = await response.json();\nconsole.log(result.candidates[0].content.parts[0].text);"
    },
    "curl": {
      "sectionTitle": "Curl 示例",
      "installLine": "说明：macOS / Linux 一般已预装 curl",
      "code": "curl -X POST \"http://10.191.0.202/v1beta/models/gemini-2.5-pro:generateContent\" \\\n  -H \"x-goog-api-key: <api_key>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"contents\":[{\"role\":\"user\",\"parts\":[{\"text\":\"What is the meaning of life?\"}]}]}'"
    }
  },

  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加 Authorization Bearer：",
    "authBearerPlaceholder": "<api_key>",
    "requestIntro": "使用 OpenAI Responses API 参数格式：",
    "requestExample": "{\n  \"instructions\": \"你是一个有帮助的助手\",\n  \"input\": \"你好，请介绍一下自己\",\n  \"temperature\": 0.5,\n  \"model\": \"gpt-6-astra\",\n  \"max_output_tokens\": 4096\n}",
    "responseExample": "{\n  \"output\": [\n    {\n      \"role\": \"assistant\",\n      \"type\": \"message\",\n      \"content\": [\n        {\n          \"text\": \"你好！我是 gpt-6-astra...\",\n          \"type\": \"output_text\"\n        }\n      ]\n    }\n  ],\n  \"output_text\": \"你好！我是 gpt-6-astra...\",\n  \"usage\": {\n    \"total_tokens\": 21,\n    \"output_tokens\": 12,\n    \"input_tokens\": 9\n  },\n  \"created_at\": 1778240000,\n  \"model\": \"gpt-6-astra\",\n  \"id\": \"resp_123\",\n  \"object\": \"response\",\n  \"status\": \"completed\"\n}",
    "docUrl": "https://platform.openai.com/docs/api-reference/responses",
    "docLabel": "查看完整 API 文档"
  },
  "exampleCodes": {
    "python": {
      "sectionTitle": "Python 示例",
      "installLine": "安装依赖：pip install requests",
      "code": "import requests\n\nurl = \"https://maas-api.antdigital.com/v1/responses\"\nheaders = {\n    \"Authorization\": \"Bearer <api_key>\",\n    \"Content-Type\": \"application/json\"\n}\ndata = {\n    \"model\": \"gpt-6-astra\",\n    \"instructions\": \"You are a helpful assistant.\",\n    \"input\": \"What is the meaning of life?\",\n    \"max_output_tokens\": 1024\n}\nresponse = requests.post(url, headers=headers, json=data)\nprint(response.json()[\"output_text\"])"
    },
    "javascript": {
      "sectionTitle": "JavaScript 示例",
      "installLine": "无需安装额外依赖（需 Node 18+ 或支持 fetch 的运行环境）",
      "code": "const response = await fetch(\"https://maas-api.antdigital.com/v1/responses\", {\n  method: \"POST\",\n  headers: {\n    \"Authorization\": \"Bearer <api_key>\",\n    \"Content-Type\": \"application/json\"\n  },\n  body: JSON.stringify({\n    model: \"gpt-6-astra\",\n    instructions: \"You are a helpful assistant.\",\n    input: \"What is the meaning of life?\",\n    max_output_tokens: 1024\n  })\n});\nconst result = await response.json();\nconsole.log(result.output_text);"
    },
    "curl": {
      "sectionTitle": "Curl 示例",
      "installLine": "说明：macOS / Linux 一般已预装 curl",
      "code": "curl -X POST \"https://maas-api.antdigital.com/v1/responses\" \\\n  -H \"Authorization: Bearer <api_key>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"model\":\"gpt-6-astra\",\"instructions\":\"You are a helpful assistant.\",\"input\":\"What is the meaning of life?\",\"max_output_tokens\":1024}'"
    }
  },

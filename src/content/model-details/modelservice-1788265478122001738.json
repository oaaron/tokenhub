  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加：",
    "authBearerPlaceholder": "YOUR_API_KEY",
    "requestIntro": "支持标准的 OpenAI 参数格式：",
    "requestExample": "{\n  \"max_tokens\": 4096,\n  \"temperature\": 0.5,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"你好，请介绍一下自己\"\n    }\n  ],\n  \"model\": \"ling-3.0-flash-vl\"\n}",

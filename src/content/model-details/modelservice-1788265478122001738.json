  "extInfo": "{\"exampleCodes\":{\"openAI\":[{\"code\":\"# pip install openai\\nfrom openai import OpenAI\\nclient = OpenAI(\\n    base_url=\\\"https://maas-api.antdigital.com/v1\\\",\\n    api_key=\\\"<api_key>\\\",\\n)\\n# Chat Completion\\ncompletion = client.chat.completions.create(\\n    model=\\\"ling-3.0-flash-vl\\\",\\n    messages=[\\n        {\\n            \\\"role\\\": \\\"user\\\",\\n            \\\"content\\\": [\\n                {\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Describe this picture\\\"},\\n                {\\\"type\\\":\\\"image_url\\\",\\\"image_url\\\":{\\\"url\\\":\\\"data:image/jpeg;base64,xxxx\\\"}}\\n            ]\\n        }\\n    ],\\n    extra_body={\\n        \\\"thinking\\\": {\\\"type\\\": \\\"enabled\\\"}\\n    }\\n)\\nprint(completion.choices[0].message.content)\\n\",\"sectionTitle\":\"\",\"name\":\"python\"},{\"code\":\"curl https://maas-api.antdigital.com/v1/chat/completions \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-H \\\"Authorization: Bearer <api_key>\\\" \\\\\\n-d '{\\n  \\\"model\\\": \\\"ling-3.0-flash-vl\\\",\\n  \\\"messages\\\": [\\n    {\\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": [\\n        {\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Describe this picture\\\"},\\n        {\\\"type\\\":\\\"image_url\\\",\\\"image_url\\\":{\\\"url\\\":\\\"data:image/jpeg;base64,xxxx\\\"}}\\n      ]\\n    }\\n  ],\\n  \\\"extra_body\\\": {\\n    \\\"thinking\\\": {\\\"type\\\": \\\"enabled\\\"}\\n  }\\n}'\\n\",\"sectionTitle\":\"\",\"name\":\"curl\"}]}}",

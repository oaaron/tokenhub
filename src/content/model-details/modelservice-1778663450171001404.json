  "extInfo": "{\"contextLength\":\"262000\",\"exampleCodes\":{\"openAI\":[{\"code\":\"from openai import OpenAI\\n\\nclient = OpenAI(\\n  base_url=\\\"https://maas-api.antdigital.com/v1\\\",\\n  api_key=\\\"<API_KEY>\\\",\\n)\\n\\n# Chat Completion\\ncompletion = client.chat.completions.create(\\n  model=\\\"kimi-k2.6\\\",\\n  messages=[\\n    {\\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": \\\"What is the meaning of life?\\\"\\n    }\\n  ]\\n)\\nprint(completion.choices[0].message.content)\\n\\n# Responses API\\nresponses = client.responses.create(\\n  model=\\\"kimi-k2.6\\\",\\n  input=\\\"What is the meaning of life?\\\"\\n)\\nprint(responses)\\n\",\"sectionTitle\":\"Code\",\"name\":\"python\"},{\"code\":\"# Chat Completion\\ncurl https://maas-api.antdigital.com/v1/chat/completions \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-H \\\"Authorization: Bearer $API_KEY\\\" \\\\\\n-d '{\\n  \\\"model\\\": \\\"kimi-k2.6\\\",\\n  \\\"messages\\\": [ \\n    { \\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": \\\"What is the meaning of life?\\\"\\n    }\\n  ]\\n}'\\n\\n# Responses API\\ncurl https://maas-api.antdigital.com/v1/responses \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-H \\\"Authorization: Bearer $API_KEY\\\" \\\\\\n-d '{\\n  \\\"model\\\": \\\"kimi-k2.6\\\",\\n  \\\"input\\\": \\\"What is the meaning of life?\\\"\\n}'\\n\",\"sectionTitle\":\"Code\",\"name\":\"curl\"}],\"anthropic\":[{\"code\":\"import anthropic\\n\\nclient = anthropic.Anthropic(\\n    api_key=\\\"<API_KEY>\\\",\\n    base_url=\\\"https://maas-api.antdigital.com/v1\\\"\\n)\\n\\n# Messages API (Anthropic 标准)\\nmessage = client.messages.create(\\n    model=\\\"kimi-k2.6\\\",\\n    max_tokens=4096,\\n    messages=[\\n        {\\n            \\\"role\\\": \\\"user\\\",\\n            \\\"content\\\": \\\"What is the meaning of life?\\\"\\n        }\\n    ]\\n)\\nprint(message.content[0].text)\",\"sectionTitle\":\"Code\",\"name\":\"python\"},{\"code\":\"# Messages API\\ncurl https://maas-api.antdigital.com/v1/messages \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-H \\\"x-api-key: $API_KEY\\\" \\\\\\n-H \\\"anthropic-version: 2023-06-01\\\" \\\\\\n-d '{\\n  \\\"model\\\": \\\"kimi-k2.6\\\",\\n  \\\"max_tokens\\\": 4096,\\n  \\\"messages\\\": [\\n    {\\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": \\\"What is the meaning of life?\\\"\\n    }\\n  ]\\n}'\",\"sectionTitle\":\"Code\",\"name\":\"curl\"}]}}",

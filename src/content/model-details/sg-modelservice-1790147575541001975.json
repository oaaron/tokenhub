  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加 Authorization Bearer：",
    "authBearerPlaceholder": "<api_key>",
    "requestIntro": "使用 OpenAI Responses API 参数格式：",
    "requestExample": "{\n  \"instructions\": \"你是一个有帮助的助手\",\n  \"input\": \"你好，请介绍一下自己\",\n  \"temperature\": 0.5,\n  \"model\": \"gpt-6-luna\",\n  \"max_output_tokens\": 4096\n}",
    "responseExample": "{\n  \"output\": [\n    {\n      \"role\": \"assistant\",\n      \"type\": \"message\",\n      \"content\": [\n        {\n          \"text\": \"你好！我是 gpt-6-luna...\",\n          \"type\": \"output_text\"\n        }\n      ]\n    }\n  ],\n  \"output_text\": \"你好！我是 gpt-6-luna...\",\n  \"usage\": {\n    \"total_tokens\": 21,\n    \"output_tokens\": 12,\n    \"input_tokens\": 9\n  },\n  \"created_at\": 1778240000,\n  \"model\": \"gpt-6-luna\",\n  \"id\": \"resp_123\",\n  \"object\": \"response\",\n  \"status\": \"completed\"\n}",

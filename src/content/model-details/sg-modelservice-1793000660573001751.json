    "docLabel": "查看完整 API 文档"
  },
  "exampleCodes": {
    "python": {
      "sectionTitle": "Python 示例",
      "installLine": "安装依赖：pip install anthropic",
      "code": "# pip install anthropic\nimport anthropic\n\nclient = anthropic.Anthropic(\n    api_key=\"<api_key>\",\n    base_url=\"https://maas-api.antdigital.com\",\n)\n\nmessage = client.messages.create(\n    model=\"claude-haiku-5-5\",\n    max_tokens=1024,\n    messages=[{\"role\": \"user\", \"content\": \"What is the meaning of life?\"}],\n)\nprint(message.content)"
    },
    "javascript": {
      "sectionTitle": "JavaScript 示例",
      "installLine": "无需安装额外依赖（需 Node 18+ 或支持 fetch 的运行环境）",
      "code": "const response = await fetch(\"https://maas-api.antdigital.com/v1/messages\", {\n  method: \"POST\",\n  headers: {\n    \"x-api-key\": \"<api_key>\",\n    \"anthropic-version\": \"2023-06-01\",\n    \"Content-Type\": \"application/json\"\n  },\n  body: JSON.stringify({\n    model: \"claude-haiku-5-5\",\n    max_tokens: 1024,\n    messages: [{ role: \"user\", content: \"What is the meaning of life?\" }]\n  })\n});\nconst result = await response.json();\nconsole.log(result.content[0].text);"
    },
    "curl": {
      "sectionTitle": "Curl 示例",
      "installLine": "说明：macOS / Linux 一般已预装 curl",
      "code": "curl -X POST \"https://maas-api.antdigital.com/v1/messages\" \\\n  -H \"x-api-key: <api_key>\" \\\n  -H \"anthropic-version: 2023-06-01\" \\\n  -H \"content-type: application/json\" \\\n  -d '{\"model\":\"claude-haiku-5-5\",\"max_tokens\":1024,\"messages\":[{\"role\":\"user\",\"content\":\"What is the meaning of life?\"}]}'"
    }
  },

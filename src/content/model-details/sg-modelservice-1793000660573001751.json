  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加 x-api-key 和 anthropic-version：",
    "authBearerPlaceholder": "<api_key>",
    "requestIntro": "使用 Anthropic Messages 协议：",
    "requestExample": "{\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"你好，请介绍一下自己\"\n    }\n  ],\n  \"model\": \"claude-haiku-5-5\"\n}",
    "responseExample": "{\n  \"role\": \"assistant\",\n  \"usage\": {\n    \"output_tokens\": 12,\n    \"input_tokens\": 9\n  },\n  \"stop_reason\": \"end_turn\",\n  \"model\": \"claude-haiku-5-5\",\n  \"id\": \"msg_123\",\n  \"type\": \"message\",\n  \"content\": [\n    {\n      \"text\": \"你好！我是 claude-haiku-5-5...\",\n      \"type\": \"text\"\n    }\n  ]\n}",

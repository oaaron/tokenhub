  "extInfo": "{\"contextLength\":\"256000\",\"exampleCodes\":{\"openAI\":[{\"code\":\"import os\\nfrom openai import OpenAI\\n\\nclient = OpenAI(\\n    api_key=os.getenv(\\\"API_KEY\\\"),\\n    base_url=\\\"https://maas-api.antdigital.com/v1\\\",\\n)\\n\\ncompletion = client.chat.completions.create(\\n    model=\\\"qwen3.5-omni-plus\\\",\\n    messages=[{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"你是谁\\\"}],\\n    # 设置输出数据的模态，当前支持两种：[\\\"text\\\",\\\"audio\\\"]、[\\\"text\\\"]\\n    modalities=[\\\"text\\\", \\\"audio\\\"],\\n    audio={\\\"voice\\\": \\\"Ethan\\\", \\\"format\\\": \\\"wav\\\"},\\n    # stream 必须设置为 True，否则会报错\\n    stream=True,\\n    stream_options={\\\"include_usage\\\": True},\\n)\\n\\nfor chunk in completion:\\n    if chunk.choices:\\n        print(chunk.choices[0].delta)\\n    else:\\n        print(chunk.usage)\",\"sectionTitle\":\"\",\"name\":\"python\"},{\"code\":\"curl https://maas-api.antdigital.com/v1/chat/completions \\\\\\n  -H \\\"Authorization: Bearer $API_KEY\\\" \\\\\\n  -H \\\"Content-Type: application/json\\\" \\\\\\n  -d '{\\n    \\\"model\\\":\\\"qwen3.5-omni-plus\\\",\\n    \\\"messages\\\":[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"你是谁\\\"}],\\n    \\\"modalities\\\":[\\\"text\\\",\\\"audio\\\"],\\n    \\\"audio\\\":{\\\"voice\\\":\\\"Ethan\\\",\\\"format\\\":\\\"wav\\\"},\\n    \\\"stream\\\":true,\\n    \\\"stream_options\\\":{\\\"include_usage\\\":true}\\n  }'\\n\",\"sectionTitle\":\"\",\"name\":\"curl\"}]},\"supportedParametersDefaultValue\":\"\"}",

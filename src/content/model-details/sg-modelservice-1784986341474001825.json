  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加 x-api-key 和 anthropic-version：",
    "authBearerPlaceholder": "<api_key>",
    "requestIntro": "使用 Anthropic Messages 协议：",
    "requestExample": "{\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"你好，请介绍一下自己\"\n    }\n  ],\n  \"model\": \"claude-opus-5\"\n}",
    "responseExample": "{\n  \"role\": \"assistant\",\n  \"usage\": {\n    \"output_tokens\": 12,\n    \"input_tokens\": 9\n  },\n  \"stop_reason\": \"end_turn\",\n  \"model\": \"claude-opus-5\",\n  \"id\": \"msg_123\",\n  \"type\": \"message\",\n  \"content\": [\n    {\n      \"text\": \"你好！我是 claude-opus-5...\",\n      \"type\": \"text\"\n    }\n  ]\n}",
    "docUrl": "https://docs.anthropic.com/en/api/messages",
    "docLabel": "查看完整 API 文档"
  },
  "exampleCodes": {
    "python": {
      "sectionTitle": "Python 示例",
      "installLine": "安装依赖：pip install anthropic",
      "code": "# pip install anthropic\nimport anthropic\n\nclient = anthropic.Anthropic(\n    api_key=\"<api_key>\",\n    base_url=\"http://10.191.0.202\",\n)\n\nmessage = client.messages.create(\n    model=\"claude-opus-5\",\n    max_tokens=1024,\n    messages=[{\"role\": \"user\", \"content\": \"What is the meaning of life?\"}],\n)\nprint(message.content)"
    },
    "javascript": {
      "sectionTitle": "JavaScript 示例",
      "installLine": "无需安装额外依赖（需 Node 18+ 或支持 fetch 的运行环境）",
      "code": "const response = await fetch(\"http://10.191.0.202/v1/messages\", {\n  method: \"POST\",\n  headers: {\n    \"x-api-key\": \"<api_key>\",\n    \"anthropic-version\": \"2023-06-01\",\n    \"Content-Type\": \"application/json\"\n  },\n  body: JSON.stringify({\n    model: \"claude-opus-5\",\n    max_tokens: 1024,\n    messages: [{ role: \"user\", content: \"What is the meaning of life?\" }]\n  })\n});\nconst result = await response.json();\nconsole.log(result.content[0].text);"
    },
    "curl": {
      "sectionTitle": "Curl 示例",
      "installLine": "说明：macOS / Linux 一般已预装 curl",
      "code": "curl -X POST \"http://10.191.0.202/v1/messages\" \\\n  -H \"x-api-key: <api_key>\" \\\n  -H \"anthropic-version: 2023-06-01\" \\\n  -H \"content-type: application/json\" \\\n  -d '{\"model\":\"claude-opus-5\",\"max_tokens\":1024,\"messages\":[{\"role\":\"user\",\"content\":\"What is the meaning of life?\"}]}'"
    }
  },

  "extInfo": "{\"contextLength\":\"1000000\",\"supportedParametersDefaultValue\":\"\",\"exampleCodes\":{\"openAI\":[{\"code\":\"from openai import OpenAI\\n\\nclient = OpenAI(\\n  base_url=\\\"https://maas-api.antdigital.com/v1\\\",\\n  api_key=\\\"<API_KEY>\\\",\\n)\\n\\n# Chat Completion\\ncompletion = client.chat.completions.create(\\n  model=\\\"qwen4-max\\\",\\n  messages=[\\n    {\\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": \\\"What is the meaning of life?\\\"\\n    }\\n  ]\\n)\\nprint(completion.choices[0].message.content)\\n\\n# Responses API\\nresponses = client.responses.create(\\n  model=\\\"qwen4-max\\\",\\n  input=\\\"What is the meaning of life?\\\"\\n)\\nprint(responses)\",\"sectionTitle\":\"\",\"name\":\"python\"},{\"code\":\"# Chat Completion\\ncurl https://maas-api.antdigital.com/v1/chat/completions \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-H \\\"Authorization: Bearer $API_KEY\\\" \\\\\\n-d '{\\n  \\\"model\\\": \\\"qwen4-max\\\",\\n  \\\"messages\\\": [ \\n    { \\n      \\\"role\\\": \\\"user\\\",\\n      \\\"content\\\": \\\"What is the meaning of life?\\\"\\n    }\\n  ]\\n}'\\n\\n# Responses API\\ncurl https://maas-api.antdigital.com/v1/responses \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-H \\\"Authorization: Bearer $API_KEY\\\" \\\\\\n-d '{\\n  \\\"model\\\": \\\"qwen4-max\\\",\\n  \\\"input\\\": \\\"What is the meaning of life?\\\"\\n}'\\n\",\"sectionTitle\":\"\",\"name\":\"curl\"}],\"dashscope\":[{\"code\":\"import os\\nfrom dashscope import Generation\\nimport dashscope\\ndashscope.base_http_api_url = 'https://maas-api.antdigital.com/v1'\\n\\nmessages = [\\n    {\\\"role\\\": \\\"system\\\", \\\"content\\\": \\\"You are a helpful assistant.\\\"},\\n    {\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"你是谁？\\\"},\\n]\\nresponse = Generation.call(\\n    # api_key = \\\"sk-xxx\\\",\\n    api_key=os.getenv(\\\"API_KEY\\\"),\\n    model=\\\"qwen4-max\\\",\\n    messages=messages,\\n    result_format=\\\"message\\\",\\n    # 开启深度思考\\n    enable_thinking=True,\\n)\\n\\nif response.status_code == 200:\\n    # 打印思考过程\\n    print(\\\"=\\\" * 20 + \\\"思考过程\\\" + \\\"=\\\" * 20)\\n    print(response.output.choices[0].message.reasoning_content)\\n    \\n    # 打印回复\\n    print(\\\"=\\\" * 20 + \\\"完整回复\\\" + \\\"=\\\" * 20)\\n    print(response.output.choices[0].message.content)\\nelse:\\n    print(f\\\"HTTP返回码：{response.status_code}\\\")\\n    print(f\\\"错误码：{response.code}\\\")\\n    print(f\\\"错误信息：{response.message}\\\")\",\"sectionTitle\":\"\",\"name\":\"python\"},{\"code\":\"curl -X POST \\\"https://maas-api.antdigital.com/api/v1/services/aigc/text-generation/generation\\\" \\\\\\n-H \\\"Authorization: Bearer $API_KEY\\\" \\\\\\n-H \\\"Content-Type: application/json\\\" \\\\\\n-d '{\\n    \\\"model\\\": \\\"qwen4-max\\\",\\n    \\\"input\\\":{\\n        \\\"messages\\\":[\\n            {\\n                \\\"role\\\": \\\"user\\\",\\n                \\\"content\\\": \\\"你是谁？\\\"\\n            }\\n        ]\\n    },\\n    \\\"parameters\\\":{\\n        \\\"enable_thinking\\\": true,\\n        \\\"result_format\\\": \\\"message\\\"\\n    }\\n}'\",\"sectionTitle\":\"\",\"name\":\"curl\"}],\"anthropic\":[{\"code\":\"import anthropic\\nclient = anthropic.Anthropic(\\n    api_key=\\\"<API_KEY>\\\", \\n    base_url=\\\"https://maas-api.antdigital.com/v1\\\"\\n)\\nmessage = client.messages.create(\\n    model=\\\"qwen4-max\\\",\\n    max_tokens=1024,\\n    messages=[\\n      {\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"Hello, Claude\\\"}\\n    ]\\n)\\nprint(message.content)\\n\",\"sectionTitle\":\"\",\"name\":\"python\"},{\"code\":\"curl https://maas-api.antdigital.com/v1/messages \\\\\\n  --header \\\"x-api-key: $API_KEY\\\" \\\\\\n  --header \\\"anthropic-version: 2023-06-01\\\" \\\\\\n  --header \\\"content-type: application/json\\\" \\\\\\n  -d '{ \\n    \\\"model\\\": \\\"qwen4-max\\\", \\n    \\\"max_tokens\\\": 1024,\\n    \\\"messages\\\": [\\n      {\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"Hello, world\\\"}\\n    ]\\n  }'\\n\",\"sectionTitle\":\"\",\"name\":\"curl\"}]}}",

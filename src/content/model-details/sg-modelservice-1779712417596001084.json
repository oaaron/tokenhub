  "usageGuide": {
    "authIntro": "使用 API Key 进行认证，在请求头中添加：",
    "authBearerPlaceholder": "YOUR_API_KEY",
    "requestIntro": "支持标准的 OpenAI 参数格式：",
    "requestExample": "{\n  \"max_tokens\": 4096,\n  \"temperature\": 0.5,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"你好，请介绍一下自己\"\n    }\n  ],\n  \"model\": \"viduq3-pro_text2video\"\n}",
    "responseExample": "{\n  \"created\": 1795357359,\n  \"usage\": {\n    \"completion_tokens\": 12,\n    \"prompt_tokens\": 9,\n    \"total_tokens\": 21\n  },\n  \"model\": \"viduq3-pro_text2video\",\n  \"id\": \"chatcmpl-123\",\n  \"choices\": [\n    {\n      \"finish_reason\": \"stop\",\n      \"index\": 0,\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"你好！我是 viduq3-pro_text2video...\"\n      }\n    }\n  ],\n  \"object\": \"chat.completion\"\n}",
